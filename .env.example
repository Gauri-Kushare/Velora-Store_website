# =========================================================================
# VELORA E-Commerce Store - Frontend Environment Variables
# =========================================================================

# Backend REST API endpoint (Express server)
VITE_API_URL=http://localhost:5000/api

# Supabase Authentication & Database Integration (Optional - falls back to Express API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Razorpay Payment Gateway (INR) - Test Key ID for checkout modal
# Get your test key from https://dashboard.razorpay.com/#/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# Direct UPI Merchant VPA (Optional - defaults to atelier.velora@hdfcbank)
VITE_MERCHANT_UPI_ID=atelier.velora@hdfcbank

