# VELORA Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=5000
NODE_ENV=development

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database Connection URL (PostgreSQL / Supabase / Neon / Local Postgres)
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example for Local: postgresql://postgres:postgres@localhost:5432/velora_db
# Leave empty to use the built-in fast zero-config JSON datastore!
DATABASE_URL=

# JWT Secret for Signing Customer Session Tokens
JWT_SECRET=velora_atelier_secret_jwt_key_super_secure_984729104
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (INR)
# Get your Key ID and Secret from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
